{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jest all",
      "type": "node",
      "request": "launch",
      "args": ["--config", "${workspaceFolder}/jest.config.ts", "--coverage", "--all"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    },
    {
      "name": "Jest current file",
      "type": "node",
      "request": "launch",
      "args": [
        "--config",
        "${workspaceFolder}/jest.config.ts",
        "--runInBand",
        "--coverage",
        "--runTestsByPath",
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    }
  ]
}
